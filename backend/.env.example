MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
JWT_SECRET=change-me-to-a-long-random-string
PORT=5000
# Frontend URLs allowed to call the API, comma-separated. Required in production.
CORS_ORIGIN=http://localhost:5173
# Number of proxies in front of the API (1 on Render or Railway). Leave empty when run directly.
TRUST_PROXY=
